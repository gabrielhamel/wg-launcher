ContextMap LauncherUpdates {
  type = SYSTEM_LANDSCAPE
  state = AS_IS

  contains LauncherDistribution, SelfUpdate

  LauncherDistribution [U] -> [D,ACL] SelfUpdate {
    implementationTechnology = "HTTPS cargo-dist manifest, archives, and checksums"
  }
}

BoundedContext LauncherDistribution {
  domainVisionStatement = "External release hosting publishes launcher binaries and their cargo-dist release contract."
}
BoundedContext SelfUpdate {
  domainVisionStatement = "wg-launcher-cli: check launcher releases, respect package-manager ownership, and verify direct executable replacement."
}
